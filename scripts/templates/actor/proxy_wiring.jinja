    // ------------------------------------------------------------------------
    // Granular Port Lifecycle Controls
    // ------------------------------------------------------------------------

    /**
     * @brief Open (activate) an individual AUTOSAR Port in a thread-safe manner.
     * For a Provided Port (P-Port / Skeleton): Calls OfferService.
     * For a Required Port (R-Port / Proxy): Calls StartFindService with ZERO locks held.
     */
    template <typename PortTag>
    void open_port() {
        static_assert(::reaktar::is_port_v<PortTag>, "open_port requires a valid generated Port Tag (e.g. ports::MyPort)!");
{% for port in model.ports %}
        {{ "if" if loop.first else "else if" }} constexpr (std::is_same_v<PortTag, typename ActorBase::ports::{{ port.port_name }}>) {
{% if port.kind == "Provided" %}
            open_{{ port.ident }}_provided_port();
{% else %}
            open_{{ port.ident }}_required_port();
{% endif %}
        }
{% endfor %}
    }

    /**
     * @brief Close (deactivate) an individual AUTOSAR Port in a thread-safe manner.
     * For a Provided Port (P-Port / Skeleton): Calls StopOfferService.
     * For a Required Port (R-Port / Proxy): Calls StopFindService with ZERO locks held, unsubscribes, and resets slot.
     */
    template <typename PortTag>
    void close_port() {
        static_assert(::reaktar::is_port_v<PortTag>, "close_port requires a valid generated Port Tag (e.g. ports::MyPort)!");
{% for port in model.ports %}
        {{ "if" if loop.first else "else if" }} constexpr (std::is_same_v<PortTag, typename ActorBase::ports::{{ port.port_name }}>) {
{% if port.kind == "Provided" %}
            close_{{ port.ident }}_provided_port();
{% else %}
            close_{{ port.ident }}_required_port();
{% endif %}
        }
{% endfor %}
    }

    /**
     * @brief Check whether an individual AUTOSAR Port is ready (wait-free and lock-free).
     * For a Provided Port (P-Port / Skeleton): Returns true if currently offered.
     * For a Required Port (R-Port / Proxy): Returns true if proxy is acquired and available.
     */
    template <typename PortTag>
    bool is_ready() const noexcept {
        static_assert(::reaktar::is_port_v<PortTag>, "is_ready requires a valid generated Port Tag (e.g. ports::MyPort)!");
{% for port in model.ports %}
        {{ "if" if loop.first else "else if" }} constexpr (std::is_same_v<PortTag, typename ActorBase::ports::{{ port.port_name }}>) {
{% if port.kind == "Provided" %}
            return this->{{ port.ident }}_offered_.load(std::memory_order_acquire);
{% else %}
            return this->{{ port.ident }}_open_.load(std::memory_order_acquire) && this->{{ port.slot_name }}.is_available();
{% endif %}
        }
{% endfor %}
    }

    /**
     * @brief Check whether an individual AUTOSAR Port has been requested open.
     */
    template <typename PortTag>
    bool is_port_open() const noexcept {
        static_assert(::reaktar::is_port_v<PortTag>, "is_port_open requires a valid generated Port Tag (e.g. ports::MyPort)!");
{% for port in model.ports %}
        {{ "if" if loop.first else "else if" }} constexpr (std::is_same_v<PortTag, typename ActorBase::ports::{{ port.port_name }}>) {
{% if port.kind == "Provided" %}
            return this->{{ port.ident }}_offered_.load(std::memory_order_acquire);
{% else %}
            return this->{{ port.ident }}_open_.load(std::memory_order_acquire);
{% endif %}
        }
{% endfor %}
    }

    /**
     * @brief Generational ticket query for diagnostics and invariant testing.
     */
    template <typename PortTag>
    uint64_t get_port_generation() const noexcept {
        static_assert(::reaktar::is_port_v<PortTag>, "get_port_generation requires a valid generated Port Tag!");
{% if model.req_ports | length > 0 %}
{% for port in model.req_ports %}
        {{ "if" if loop.first else "else if" }} constexpr (std::is_same_v<PortTag, typename ActorBase::ports::{{ port.port_name }}>) {
            std::lock_guard<std::mutex> lock(this->{{ port.ident }}_port_mutex_);
            return this->{{ port.ident }}_generation_;
        }
{% endfor %}
        else {
            return 0;
        }
{% else %}
        return 0;
{% endif %}
    }

    // Bring ActorBase::is_ready() (no-arg readiness check across all ports) into scope
    using ActorBase::is_ready;
    using ActorBase::wait_until_ready;

    // ------------------------------------------------------------------------
    // Process-Wide Lifecycle Controls (Granular Defaults)
    // ------------------------------------------------------------------------

    void start() {
{% for port in model.ports %}
        this->template open_port<typename ActorBase::ports::{{ port.port_name }}>();
{% endfor %}
    }

    void stop() {
{% for port in model.ports %}
        this->template close_port<typename ActorBase::ports::{{ port.port_name }}>();
{% endfor %}
    }

    static constexpr bool has_any_lifecycle_handlers_v = {% if model.ports | length == 0 %}false{% else %}(
{% for port in model.ports %}
        ::reaktar::has_on_direct_event_v<Derived, ::reaktar::Connected<typename ActorBase::ports::{{ port.port_name }}>> ||
        ::reaktar::has_on_direct_event_v<Derived, ::reaktar::Disconnected<typename ActorBase::ports::{{ port.port_name }}>>{{ " ||" if not loop.last else "" }}
{% endfor %}
    ){% endif %};

    /**
     * @brief Synchronously drain port lifecycle state transitions and dispatch Connected/Disconnected events.
     * Fully zero-cost: if Derived defines no lifecycle handlers, this is pruned at compile time to 'return 0;'.
     * @return Number of lifecycle events dispatched.
     */
    size_t drain() {
        if constexpr (!has_any_lifecycle_handlers_v) {
            return 0;
        } else {
            typename ActorBase::port_mask_t dirty = this->dirty_ports_.load(std::memory_order_relaxed);
            if (!dirty) return 0;
            dirty = this->dirty_ports_.exchange(0, std::memory_order_acq_rel);
            if (!dirty) return 0;

            size_t count = 0;
            auto reconcile = [this, dirty, &count]() {
{% for port in model.ports %}
                if constexpr (::reaktar::has_on_direct_event_v<Derived, ::reaktar::Connected<typename ActorBase::ports::{{ port.port_name }}>> ||
                              ::reaktar::has_on_direct_event_v<Derived, ::reaktar::Disconnected<typename ActorBase::ports::{{ port.port_name }}>>) {
                    if (dirty & (static_cast<typename ActorBase::port_mask_t>(1) << {{ loop.index0 }})) {
                        bool is_now_ready = this->template is_ready<typename ActorBase::ports::{{ port.port_name }}>();
                        bool was_ready = (this->last_known_ready_ & (static_cast<typename ActorBase::port_mask_t>(1) << {{ loop.index0 }})) != 0;
                        if (is_now_ready != was_ready) {
                            if (is_now_ready) {
                                this->last_known_ready_ |= (static_cast<typename ActorBase::port_mask_t>(1) << {{ loop.index0 }});
                                if constexpr (::reaktar::has_on_direct_event_v<Derived, ::reaktar::Connected<typename ActorBase::ports::{{ port.port_name }}>>) {
                                    self().on(::reaktar::Connected<typename ActorBase::ports::{{ port.port_name }}>{});
                                    ++count;
                                }
                            } else {
                                this->last_known_ready_ &= ~(static_cast<typename ActorBase::port_mask_t>(1) << {{ loop.index0 }});
                                if constexpr (::reaktar::has_on_direct_event_v<Derived, ::reaktar::Disconnected<typename ActorBase::ports::{{ port.port_name }}>>) {
                                    self().on(::reaktar::Disconnected<typename ActorBase::ports::{{ port.port_name }}>{});
                                    ++count;
                                }
                            }
                        }
                    }
                }
{% endfor %}
            };

            if constexpr (std::is_same_v<ExecutionPolicy, ::reaktar::DirectExecution>) {
                reconcile();
            } else if constexpr (std::is_same_v<ExecutionPolicy, ::reaktar::SynchronizedExecution>) {
                std::lock_guard<std::mutex> lock(this->execution_policy_.mutex());
                reconcile();
            } else {
                this->execution_policy_.execute(reconcile);
            }
            return count;
        }
    }

private:
{% for port in model.ports %}
{% if port.kind == "Provided" %}
    void open_{{ port.ident }}_provided_port() {
        std::lock_guard<std::mutex> lock(this->{{ port.ident }}_port_mutex_);
        if (!this->{{ port.ident }}_offered_.load(std::memory_order_relaxed)) {
            bind_skeleton_fields();
            this->{{ port.var_name }}.OfferService();
            this->{{ port.ident }}_offered_.store(true, std::memory_order_release);
            if constexpr (::reaktar::has_on_direct_event_v<Derived, ::reaktar::Connected<typename ActorBase::ports::{{ port.port_name }}>> ||
                          ::reaktar::has_on_direct_event_v<Derived, ::reaktar::Disconnected<typename ActorBase::ports::{{ port.port_name }}>>) {
                this->dirty_ports_.fetch_or(static_cast<typename ActorBase::port_mask_t>(1) << {{ loop.index0 }}, std::memory_order_release);
            }
        }
    }
{% else %}
    void open_{{ port.ident }}_required_port() {
        uint64_t my_gen{0};
        {
            std::lock_guard<std::mutex> lock(this->{{ port.ident }}_port_mutex_);
            if (this->{{ port.ident }}_open_.load(std::memory_order_acquire)) {
                return; // Already open or opening
            }
            this->{{ port.ident }}_open_.store(true, std::memory_order_release);
            my_gen = ++this->{{ port.ident }}_generation_;
        }

        bool find_started = false;
        struct ExceptionRollbackGuard {
            std::atomic<bool>& open_flag;
            bool& ok;
            ~ExceptionRollbackGuard() {
                if (!ok) {
                    open_flag.store(false, std::memory_order_release);
                }
            }
        } rollback_guard{this->{{ port.ident }}_open_, find_started};

        // Call StartFindService with ZERO locks held
        auto find_res = {{ port.cls }}::StartFindService(
            [this, my_gen](ara::com::ServiceHandleContainer<typename {{ port.cls }}::HandleType> handles, ara::com::FindServiceHandle) {
                if (!this->{{ port.ident }}_open_.load(std::memory_order_acquire)) {
                    return; // Port was closed
                }
                {
                    std::lock_guard<std::mutex> h_lock(this->{{ port.ident }}_port_mutex_);
                    if (this->{{ port.ident }}_generation_ != my_gen) {
                        return; // Stale callback from an earlier generation
                    }
                }
                if (handles.empty()) {
                    std::lock_guard<std::mutex> h_lock(this->{{ port.ident }}_port_mutex_);
                    if (!this->{{ port.ident }}_open_.load(std::memory_order_acquire) ||
                        this->{{ port.ident }}_generation_ != my_gen) {
                        return; // Closed or generation shifted concurrently
                    }
                    this->{{ port.slot_name }}.reset();
                    if constexpr (::reaktar::has_on_direct_event_v<Derived, ::reaktar::Connected<typename ActorBase::ports::{{ port.port_name }}>> ||
                                  ::reaktar::has_on_direct_event_v<Derived, ::reaktar::Disconnected<typename ActorBase::ports::{{ port.port_name }}>>) {
                        this->dirty_ports_.fetch_or(static_cast<typename ActorBase::port_mask_t>(1) << {{ loop.index0 }}, std::memory_order_release);
                    }
                } else {
                    if (auto cur_h = this->{{ port.slot_name }}.get_handle(); cur_h.has_value() && *cur_h == handles[0]) {
                        return; // Same handle, already active
                    }
                    // Zero-downtime update: do NOT wipe slot before creating new proxy!
                    // ProxySlot::publish handles atomic cell exchange, bounded reader drain, and teardown hook cleanly.
                    auto new_proxy = std::make_unique<{{ port.cls }}>(handles[0]);
                    bind_{{ port.ident }}_signals(*new_proxy);

                    auto teardown_hook = []([[maybe_unused]] {{ port.cls }}& p) {
{% for target in port.all_unsubscribe_targets %}
                        p.{{ target }}.Unsubscribe();
{% endfor %}
                    };

                    {
                        std::lock_guard<std::mutex> h_lock(this->{{ port.ident }}_port_mutex_);
                        if (!this->{{ port.ident }}_open_.load(std::memory_order_acquire) ||
                            this->{{ port.ident }}_generation_ != my_gen) {
                            return; // Closed or generation shifted concurrently
                        }
                        this->{{ port.slot_name }}.publish(std::move(new_proxy), handles[0], teardown_hook);
                        if constexpr (::reaktar::has_on_direct_event_v<Derived, ::reaktar::Connected<typename ActorBase::ports::{{ port.port_name }}>> ||
                                      ::reaktar::has_on_direct_event_v<Derived, ::reaktar::Disconnected<typename ActorBase::ports::{{ port.port_name }}>>) {
                            this->dirty_ports_.fetch_or(static_cast<typename ActorBase::port_mask_t>(1) << {{ loop.index0 }}, std::memory_order_release);
                        }
                    }
                    // Safe publication complete: now activate signal subscriptions with zero locks held!
                    if (auto lease = this->{{ port.slot_name }}.try_acquire()) {
                        subscribe_{{ port.ident }}_signals(*lease);
                    }
                    this->notify_proxy_resolved();
                }
            },
            reaktar::InstanceSpecifier("{{ port.instance_spec }}")
        );

        std::optional<ara::com::FindServiceHandle> handle;
        if constexpr (reaktar::is_result_v<decltype(find_res)>) {
            if (find_res.HasValue()) {
                handle = find_res.Value();
            }
        } else {
            handle = find_res;
        }

        if (!handle.has_value()) {
            std::lock_guard<std::mutex> lock(this->{{ port.ident }}_port_mutex_);
            if (this->{{ port.ident }}_generation_ == my_gen) {
                this->{{ port.ident }}_open_.store(false, std::memory_order_release);
            }
            return;
        }

        find_started = true; // Successfully started, prevent rollback

        bool should_stop = false;
        {
            std::lock_guard<std::mutex> lock(this->{{ port.ident }}_port_mutex_);
            if (!this->{{ port.ident }}_open_.load(std::memory_order_acquire) || this->{{ port.ident }}_generation_ != my_gen) {
                // Port was closed or generation shifted while StartFindService was executing!
                should_stop = true;
            } else {
                this->{{ port.find_handle_name }} = *handle;
            }
        }
        if (should_stop) {
            {{ port.cls }}::StopFindService(*handle);
            return;
        }
    }
{% endif %}
{% endfor %}

{% for port in model.ports %}
{% if port.kind == "Provided" %}
    void close_{{ port.ident }}_provided_port() {
        std::lock_guard<std::mutex> lock(this->{{ port.ident }}_port_mutex_);
        if (this->{{ port.ident }}_offered_.load(std::memory_order_relaxed)) {
            this->{{ port.var_name }}.StopOfferService();
            this->{{ port.ident }}_offered_.store(false, std::memory_order_release);
            if constexpr (::reaktar::has_on_direct_event_v<Derived, ::reaktar::Connected<typename ActorBase::ports::{{ port.port_name }}>> ||
                          ::reaktar::has_on_direct_event_v<Derived, ::reaktar::Disconnected<typename ActorBase::ports::{{ port.port_name }}>>) {
                this->dirty_ports_.fetch_or(static_cast<typename ActorBase::port_mask_t>(1) << {{ loop.index0 }}, std::memory_order_release);
            }
        }
    }
{% else %}
    void close_{{ port.ident }}_required_port() {
        std::optional<ara::com::FindServiceHandle> handle_to_stop;
        {
            std::lock_guard<std::mutex> lock(this->{{ port.ident }}_port_mutex_);
            if (!this->{{ port.ident }}_open_.load(std::memory_order_relaxed) && !this->{{ port.find_handle_name }}.has_value()) {
                return;
            }
            this->{{ port.ident }}_open_.store(false, std::memory_order_release);
            ++this->{{ port.ident }}_generation_;
            handle_to_stop = this->{{ port.find_handle_name }};
            this->{{ port.find_handle_name }}.reset();
            this->{{ port.slot_name }}.reset();
            if constexpr (::reaktar::has_on_direct_event_v<Derived, ::reaktar::Connected<typename ActorBase::ports::{{ port.port_name }}>> ||
                          ::reaktar::has_on_direct_event_v<Derived, ::reaktar::Disconnected<typename ActorBase::ports::{{ port.port_name }}>>) {
                this->dirty_ports_.fetch_or(static_cast<typename ActorBase::port_mask_t>(1) << {{ loop.index0 }}, std::memory_order_release);
            }
        }

        if (handle_to_stop.has_value()) {
            {{ port.cls }}::StopFindService(*handle_to_stop);
        }
    }
{% endif %}
{% endfor %}

private:

    void bind_skeleton_fields() {
{% for f in model.skeleton_fields %}
{% if f.has_notifier or f.has_getter %}
        // Initialise field value before OfferService (required by AUTOSAR Adaptive caching/notifier semantics)
        {{ f.var_name }}.{{ f.name }}.Update({});
{% endif %}
{% endfor %}
{% for f in model.skeleton_setters %}
        using {{ f.port_ident }}_{{ f.name }}_Port_ = typename ActorBase::ports::{{ f.port_name }};
        using {{ f.port_ident }}_{{ f.name }}_PortTag_ = typename {{ f.port_ident }}_{{ f.name }}_Port_::{{ f.name }};
        using {{ f.port_ident }}_{{ f.name }}_PortAny_ = typename {{ f.port_ident }}_{{ f.name }}_Port_::Any;
        using {{ f.port_ident }}_{{ f.name }}_TagAny_ = typename {{ f.tag }}::Any;

        static constexpr bool kHas_on_{{ f.port_ident }}_{{ f.name }}_port_tag   = ::reaktar::has_on_setter_v<Derived, {{ f.port_ident }}_{{ f.name }}_PortTag_, {{ f.type }}>;
        static constexpr bool kHas_on_{{ f.port_ident }}_{{ f.name }}_port_bare  = ::reaktar::has_on_setter_v<Derived, {{ f.port_ident }}_{{ f.name }}_Port_, {{ f.type }}>;
        static constexpr bool kHas_on_{{ f.port_ident }}_{{ f.name }}_port_any   = ::reaktar::has_on_setter_v<Derived, {{ f.port_ident }}_{{ f.name }}_PortAny_, {{ f.type }}>;
        static constexpr bool kHas_on_{{ f.port_ident }}_{{ f.name }}_tag_any    = ::reaktar::has_on_setter_v<Derived, {{ f.port_ident }}_{{ f.name }}_TagAny_, {{ f.type }}>;
        static constexpr bool kHas_on_{{ f.port_ident }}_{{ f.name }}_tagged     = ::reaktar::has_on_setter_v<Derived, {{ f.tag }}, {{ f.type }}>;
        static constexpr bool kHas_on_{{ f.port_ident }}_{{ f.name }}_global_any = ::reaktar::has_on_setter_v<Derived, ::reaktar::Any, {{ f.type }}>;
        static constexpr bool kHas_on_{{ f.port_ident }}_{{ f.name }}_direct     = ::reaktar::has_on_direct_setter_v<Derived, {{ f.type }}>;

        auto register_{{ f.port_ident }}_{{ f.name }} = [this](auto&& invoke) {
            if constexpr (std::is_same_v<ExecutionPolicy, ::reaktar::DirectExecution>) {
                {{ f.var_name }}.{{ f.name }}.RegisterSetHandler([invoke = std::forward<decltype(invoke)>(invoke)](const {{ f.type }}& val) {
                    return result_adapter<reaktar::Future<{{ f.type }}>, decltype(invoke(val))>::adapt(invoke(val));
                });
            } else if constexpr (std::is_same_v<ExecutionPolicy, ::reaktar::SynchronizedExecution>) {
                {{ f.var_name }}.{{ f.name }}.RegisterSetHandler([this, invoke = std::forward<decltype(invoke)>(invoke)](const {{ f.type }}& val) {
                    std::lock_guard<std::mutex> lock(this->execution_policy_.mutex());
                    return result_adapter<reaktar::Future<{{ f.type }}>, decltype(invoke(val))>::adapt(invoke(val));
                });
            } else {
                {{ f.var_name }}.{{ f.name }}.RegisterSetHandler([this, invoke = std::forward<decltype(invoke)>(invoke)](const {{ f.type }}& val) {
                    return this->execution_policy_.execute([&] {
                        return result_adapter<reaktar::Future<{{ f.type }}>, decltype(invoke(val))>::adapt(invoke(val));
                    });
                });
            }
        };

        if constexpr (kHas_on_{{ f.port_ident }}_{{ f.name }}_port_tag) {
            register_{{ f.port_ident }}_{{ f.name }}([this](const {{ f.type }}& val) {
                return self().on({{ f.port_ident }}_{{ f.name }}_PortTag_{}, val);
            });
        }
{% if f.is_unique_setter_on_port %}
        else if constexpr (kHas_on_{{ f.port_ident }}_{{ f.name }}_port_bare) {
            register_{{ f.port_ident }}_{{ f.name }}([this](const {{ f.type }}& val) {
                return self().on({{ f.port_ident }}_{{ f.name }}_Port_{}, val);
            });
        }
{% else %}
        else if constexpr (kHas_on_{{ f.port_ident }}_{{ f.name }}_port_bare) {
#if REAKTAR_AMBIGUITY_VALIDATION
            static_assert(!sizeof(Derived*),
                "reaktar::on() collision: field type '{{ f.type }}' is shared across multiple field setters on port '{{ f.port_name }}'. You must specify the port field tag: on(ports::{{ f.port_name }}::{{ f.name }}, const {{ f.type }}& val) instead of on(ports::{{ f.port_name }}, ...).\n"
                "Competing field setters on port '{{ f.port_name }}':\n"
{% for item in f.competing_on_port %}
                "  - ports::{{ f.port_name }}::{{ item.name }}\n"
{% endfor %}
            );
#else
            register_{{ f.port_ident }}_{{ f.name }}([this](const {{ f.type }}& val) {
                return self().on({{ f.port_ident }}_{{ f.name }}_Port_{}, val);
            });
#endif
        }
{% endif %}
        else if constexpr (kHas_on_{{ f.port_ident }}_{{ f.name }}_port_any) {
            register_{{ f.port_ident }}_{{ f.name }}([this](const {{ f.type }}& val) {
                return self().on({{ f.port_ident }}_{{ f.name }}_PortAny_{}, val);
            });
        }
        else if constexpr (kHas_on_{{ f.port_ident }}_{{ f.name }}_tag_any) {
            register_{{ f.port_ident }}_{{ f.name }}([this](const {{ f.type }}& val) {
                return self().on({{ f.port_ident }}_{{ f.name }}_TagAny_{}, val);
            });
        }
        else if constexpr (kHas_on_{{ f.port_ident }}_{{ f.name }}_tagged) {
            register_{{ f.port_ident }}_{{ f.name }}([this](const {{ f.type }}& val) {
                return self().on({{ f.tag }}{}, val);
            });
        }
        else if constexpr (kHas_on_{{ f.port_ident }}_{{ f.name }}_global_any) {
            register_{{ f.port_ident }}_{{ f.name }}([this](const {{ f.type }}& val) {
                return self().on(::reaktar::Any{}, val);
            });
        }
{% if f.is_unique_setter %}
        else if constexpr (kHas_on_{{ f.port_ident }}_{{ f.name }}_direct) {
            register_{{ f.port_ident }}_{{ f.name }}([this](const {{ f.type }}& val) {
                return self().on(val);
            });
        }
{% else %}
        else if constexpr (kHas_on_{{ f.port_ident }}_{{ f.name }}_direct) {
#if REAKTAR_AMBIGUITY_VALIDATION
            static_assert(!sizeof(Derived*),
                "reaktar::on() collision: field type '{{ f.type }}' is shared across multiple field setters. You must specify the tag: on({{ f.tag }}, const {{ f.type }}& val) or port tag: on(typename ActorBase::ports::{{ f.port_name }}::{{ f.name }}, const {{ f.type }}& val).\n"
                "Competing incoming channels for type '{{ f.type }}':\n"
{% for tgt in f.competing_all %}
                "  - ports::{{ tgt.port }}::{{ tgt.member }} ({{ tgt.kind }})\n"
{% endfor %}
            );
#else
            register_{{ f.port_ident }}_{{ f.name }}([this](const {{ f.type }}& val) {
                return self().on(val);
            });
#endif
        }
{% endif %}
{% endfor %}
    }

    void check_handler_collisions() {
{% for sig in model.inbound_signals_flat %}
        {
            using Port_ = typename ActorBase::ports::{{ sig.port_name }};
            using PortTag_ = typename Port_::{{ sig.name }};
            using PortAny_ = typename Port_::Any;
            using SignalAny_ = typename {{ sig.tag }}::Any;
            constexpr bool kHas_port_tag   = has_on_event_v<Derived, PortTag_, {{ sig.type }}>;
            constexpr bool kHas_port_bare  = has_on_event_v<Derived, Port_, {{ sig.type }}>;
            constexpr bool kHas_port_any   = has_on_event_v<Derived, PortAny_, {{ sig.type }}>;
            constexpr bool kHas_signal_any = has_on_event_v<Derived, SignalAny_, {{ sig.type }}>;
            constexpr bool kHas_tagged     = has_on_event_v<Derived, {{ sig.tag }}, {{ sig.type }}>;
            constexpr bool kHas_direct     = has_on_direct_event_v<Derived, {{ sig.type }}>;
            constexpr bool kHas_global_any = has_on_event_v<Derived, ::reaktar::Any, {{ sig.type }}>;
#if REAKTAR_AMBIGUITY_VALIDATION
            static_assert(
                (int(kHas_port_tag) + int(kHas_port_bare) + int(kHas_port_any) + int(kHas_signal_any) + int(kHas_tagged) + int(kHas_direct) + int(kHas_global_any)) <= 1,
                "reaktar: Multiple conflicting on(...) handlers declared for {{ sig.signal_label }} '{{ sig.name }}' on port '{{ sig.port_name }}'! "
                "You must define only one: on(ports::{{ sig.port_name }}::{{ sig.name }}, ...), on({{ sig.tag }}, ...), on(ports::{{ sig.port_name }}::Any, ...), on({{ sig.tag }}::Any, ...), on(reaktar::Any, ...), on(ports::{{ sig.port_name }}, ...), or on(...)."
            );
