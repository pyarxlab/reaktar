            proxy->{{ f.name }}.Subscribe(10);
        }
{% else %}
        else if constexpr (has_on_direct_event_v<Derived, {{ f.type }}>) {
            static_assert(!sizeof(Derived*), "reaktar::on() collision: type '{{ f.type }}' is shared across multiple incoming channels (events/fields). You must specify the tag: void on({{ f.tag }}, const {{ f.type }}& val).");
        }
{% endif %}
{% endif %}
{% endfor %}
    }
{% endfor %}
