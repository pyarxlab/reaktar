{% endif %}
        }
{% endfor %}
{% for ambig in model.outbound_ambiguous_tags %}
        else if constexpr (std::is_same_v<Tag, {{ ambig.tag }}>) {
            static_assert(!sizeof(Tag*), "reaktar: emit<Tag>(...) is ambiguous across multiple ports sharing the '{{ ambig.service }}' interface! Use emit<ports::PortName::Tag>(...) or emit<ports::PortName>(...) instead.");
        }
{% endfor %}
        else {
            static_assert(!sizeof(Tag*), "reaktar: emit called with unknown tag!");
        }
{% else %}
        static_assert(!sizeof(Tag*), "reaktar: emit called with unknown tag (no outgoing events/methods available)!");
{% endif %}
    }

    template <typename Tag, typename... Args>
    auto call(Args&&... args) {
        return emit<Tag>(std::forward<Args>(args)...);
    }

