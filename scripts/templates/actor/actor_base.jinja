/**
 * @brief Non-templated Actor Base for {{ model.exe_name }}
 *
 * Provides pure ergonomic Tag aliases and unqualified `emit(...)`.
 * Does NOT inherit from Skeletons to completely eliminate name collisions/shadowing!
 */
class {{ model.exe_name }}ActorBase
{
public:
    // ------------------------------------------------------------------------
    // Ergonomic Tag Aliases (brought directly into Actor class scope)
    // ------------------------------------------------------------------------
{% for alias in model.tag_aliases %}
{% if not alias.is_ambiguous %}
    using {{ alias.name }} = {{ alias.target }};
{% else %}
    // Ambiguous tag '{{ alias.name }}': {{ alias.conflicts }} -> use fully qualified name.
{% endif %}
{% endfor %}

    using Any = ::reaktar::Any;
    using All = Any;

    // ------------------------------------------------------------------------
    // Generated AUTOSAR Port Tags
    // ------------------------------------------------------------------------
    struct ports {
        using Any = ::reaktar::Any;
        using All = Any;
{% for port in model.ports %}
        struct {{ port.port_name }} : public {{ port.kind_tag }} {
            static constexpr std::string_view name = "{{ port.port_name }}";
            static constexpr size_t port_index = {{ loop.index0 }};
            using port_tag = {{ port.port_name }};
            using kind_type = {{ port.kind_tag }};

            struct Any {
                using port_type = {{ port.port_name }};
                static constexpr std::string_view port_name = "{{ port.port_name }}";
            };
            using All = Any;
{% for ev in port.events %}
            struct {{ ev.name }} {
                using port_type = {{ port.port_name }};
                static constexpr std::string_view port_name = "{{ port.port_name }}";
                static constexpr std::string_view event_name = "{{ ev.name }}";
                using Any = ::reaktar::tags::{{ port.service_ns }}::events::{{ ev.name }}::Any;
                using All = Any;
            };
{% endfor %}
{% for f in port.fields %}
            struct {{ f.name }} {
                using port_type = {{ port.port_name }};
                static constexpr std::string_view port_name = "{{ port.port_name }}";
                static constexpr std::string_view field_name = "{{ f.name }}";
                using Any = ::reaktar::tags::{{ port.service_ns }}::fields::{{ f.name }}::Any;
                using All = Any;
            };
{% endfor %}
{% for m in port.methods %}
            struct {{ m.name }} {
                using port_type = {{ port.port_name }};
                static constexpr std::string_view port_name = "{{ port.port_name }}";
                static constexpr std::string_view method_name = "{{ m.name }}";
                using Any = ::reaktar::tags::{{ port.service_ns }}::methods::{{ m.name }}::Any;
                using All = Any;
            };
{% endfor %}
        };
{% endfor %}
        static constexpr size_t kPortCount = {{ model.ports | length }};

        // Target CPU architecture detection (32-bit vs 64-bit)
        static constexpr bool kIs32BitArch = (sizeof(void*) == 4);

        // On 32-bit embedded platforms, use native uint32_t to guarantee 1-instruction lock-free execution
        // On 64-bit platforms, use uint32_t for <= 32 ports and uint64_t for up to 64 ports
        using port_mask_t = std::conditional_t<
            kIs32BitArch || (kPortCount <= 32),
            uint32_t,
            uint64_t
        >;

        static constexpr size_t kMaxSupportedPorts = sizeof(port_mask_t) * 8;
        static_assert(kPortCount <= kMaxSupportedPorts,
            "Port count exceeds maximum lock-free atomic mask capacity on this architecture (32 ports on 32-bit, 64 on 64-bit)");
        static_assert(std::atomic<port_mask_t>::is_always_lock_free,
            "ReaktAR port_mask_t must be unconditionally lock-free on target architecture");


{% if model.port_aliases %}

        // --------------------------------------------------------------------
        // Ergonomic Port Aliases (affixes stripped when collision-free)
        // --------------------------------------------------------------------
{% for alias in model.port_aliases %}
{% if not alias.is_ambiguous %}
        using {{ alias.alias }} = {{ alias.target }};
{% else %}
        // Ambiguous port alias '{{ alias.alias }}' between: {{ alias.conflicts }} -> use canonical names
{% endif %}
{% endfor %}
{% endif %}
    };

    // ------------------------------------------------------------------------
    // Type Traits for Low-Level Static & Unit-Level Invocability Testing
    // ------------------------------------------------------------------------
    struct traits {
        // --- 1. Bare Untagged emit(payload) Traits ---
        template <typename Payload>
        static constexpr bool is_ambiguous_emit_v =
{% for ambig_t in model.outbound_ambiguous_types %}
            std::is_same_v<std::decay_t<Payload>, {{ ambig_t }}> ||
{% endfor %}
            false;

        template <typename Payload>
        static constexpr bool can_emit_v =
{% for item in model.outbound_by_type %}
            std::is_same_v<std::decay_t<Payload>, {{ item.type }}> ||
{% endfor %}
            false;

        // --- 2. Port Validity & Capability Traits ---
        template <typename Port>
        static constexpr bool is_valid_port_v =
{% for port in model.ports %}
            std::is_same_v<Port, ports::{{ port.port_name }}> ||
{% endfor %}
            false;

        template <typename Port>
        static constexpr bool has_port_outbound_v =
{% for port in model.ports_outbound %}
{% if port.total_outbound_count > 0 %}
            std::is_same_v<Port, ports::{{ port.name }}> ||
{% endif %}
{% endfor %}
            false;

        // --- 3. Port-Targeted emit<Port>(payload) Traits ---
        template <typename Port, typename Payload>
        static constexpr bool is_port_payload_ambiguous_v =
{% for port in model.ports_outbound %}
{% for item in port.single_arg_items %}
{% if item.is_ambiguous %}
            (std::is_same_v<Port, ports::{{ port.name }}> && std::is_same_v<std::decay_t<Payload>, {{ item.type }}>) ||
{% endif %}
{% endfor %}
{% endfor %}
            false;

        template <typename Port, typename Payload>
        static constexpr bool can_port_emit_v =
{% for port in model.ports_outbound %}
{% for item in port.single_arg_items %}
{% if not item.is_ambiguous %}
            (std::is_same_v<Port, ports::{{ port.name }}> && std::is_same_v<std::decay_t<Payload>, {{ item.type }}>) ||
{% endif %}
{% endfor %}
{% endfor %}
            false;

        // --- 4. Tag Invocability & Ambiguity Traits ---
        template <typename Tag>
        static constexpr bool is_ambiguous_tag_v =
{% for ambig in model.outbound_ambiguous_tags %}
            std::is_same_v<Tag, {{ ambig.tag }}> ||
{% endfor %}
            false;

        template <typename Tag>
        static constexpr bool can_tag_emit_v =
{% for item in model.outbound_tagged %}
            std::is_same_v<Tag, {{ item.tag | replace('typename ActorBase::', '') }}> ||
{% endfor %}
            false;

        // --- 5. Global Wildcard Fan-Out (emit<reaktar::Any>(payload)) ---
        template <typename Payload>
        static constexpr bool can_fan_out_v =
{% for group in model.global_outbound_by_type %}
            std::is_same_v<std::decay_t<Payload>, {{ group.type }}> ||
{% endfor %}
            false;

        template <typename Payload>
        static constexpr size_t fan_out_target_count_v =
{% for group in model.global_outbound_by_type %}
            std::is_same_v<std::decay_t<Payload>, {{ group.type }}> ? {{ group.targets | length }} :
{% endfor %}
            0;

        // --- 6. Tagged Wildcard Fan-Out (emit<Tag::Any>(args...)) ---
        template <typename Tag>
        static constexpr bool can_tag_fan_out_v =
{% for item in model.outbound_fan_out_tags %}
{% if (item.kind == "method" and item.is_faf and item.ret_type == "void") or
      (item.kind == "event") or
      (item.kind == "field" and item.has_notifier and item.matching_ports | length > 0) %}
            std::is_same_v<Tag, {{ item.tag }}> ||
{% endif %}
{% endfor %}
            false;

        template <typename Tag>
        static constexpr bool is_rejected_fan_out_tag_v =
{% for item in model.outbound_fan_out_tags %}
{% if (item.kind == "method" and (item.ret_type != "void" or not item.is_faf)) or
      (item.kind == "field" and (item.has_setter or (item.has_getter and not item.has_notifier) or (item.matching_ports | length == 0))) %}
            std::is_same_v<Tag, {{ item.tag }}> ||
{% endif %}
{% endfor %}
            false;

        // --- 7. Tagged Wildcard Fan-Out Arguments Matching ---
        template <typename Tag, typename... Args>
        static constexpr bool can_tag_fan_out_with_args_v =
{% for item in model.outbound_fan_out_tags %}
{% if (item.kind == "method" and item.is_faf and item.ret_type == "void") %}
            (std::is_same_v<Tag, {{ item.tag }}> && std::is_same_v<std::tuple<std::decay_t<Args>...>, std::tuple<{% for t in item.sig_types %}{{ t }}{% if not loop.last %}, {% endif %}{% endfor %}>>) ||
{% elif item.kind == "event" %}
            (std::is_same_v<Tag, {{ item.tag }}> && std::is_same_v<std::tuple<std::decay_t<Args>...>, std::tuple<{{ item.payload_type }}>>) ||
{% elif item.kind == "field" and item.has_notifier and item.matching_ports | length > 0 %}
            (std::is_same_v<Tag, {{ item.tag }}> && std::is_same_v<std::tuple<std::decay_t<Args>...>, std::tuple<{{ item.type }}>>) ||
{% endif %}
{% endfor %}
            false;

        // --- 8. Inbound Handlers (on) Traits ---
        template <typename Payload>
        static constexpr bool is_ambiguous_on_v =
{% for ambig_t in model.inbound_ambiguous_types %}
            std::is_same_v<std::decay_t<Payload>, {{ ambig_t }}> ||
{% endfor %}
            false;

        template <typename Payload>
        static constexpr bool can_on_v =
{% for item in model.inbound_by_type %}
            std::is_same_v<std::decay_t<Payload>, {{ item.type }}> ||
{% endfor %}
            false;

        template <typename Payload>
        static constexpr bool can_fan_in_v =
{% for t in model.inbound_all_types %}
            std::is_same_v<std::decay_t<Payload>, {{ t }}> ||
{% endfor %}
            false;

        template <typename Port>
        static constexpr bool has_port_inbound_v =
{% for port in model.ports_inbound %}
{% if port.total_inbound_count > 0 %}
            std::is_same_v<Port, ports::{{ port.name }}> ||
{% endif %}
{% endfor %}
            false;

        template <typename Port, typename Payload>
        static constexpr bool is_port_on_ambiguous_v =
{% for port in model.ports_inbound %}
{% for item in port.single_arg_items %}
{% if item.is_ambiguous %}
            (std::is_same_v<Port, ports::{{ port.name }}> && std::is_same_v<std::decay_t<Payload>, {{ item.type }}>) ||
{% endif %}
{% endfor %}
{% endfor %}
            false;

        template <typename Port, typename Payload>
        static constexpr bool can_port_on_v =
{% for port in model.ports_inbound %}
{% for item in port.single_arg_items %}
{% if not item.is_ambiguous %}
            (std::is_same_v<Port, ports::{{ port.name }}> && std::is_same_v<std::decay_t<Payload>, {{ item.type }}>) ||
{% endif %}
{% endfor %}
{% endfor %}
            false;

        template <typename Tag>
        static constexpr bool is_ambiguous_tag_on_v =
{% for ambig in model.inbound_ambiguous_tags %}
            std::is_same_v<Tag, {{ ambig.tag }}> ||
{% endfor %}
            false;

        template <typename Tag>
        static constexpr bool can_tag_on_v =
{% for item in model.inbound_tagged %}
            std::is_same_v<Tag, {{ item.tag | replace('typename ActorBase::', '') }}> ||
{% endfor %}
{% for item in model.inbound_fan_in_tags %}
            std::is_same_v<Tag, typename {{ item.tag }}::Any> ||
{% endfor %}
{% for port in model.ports_inbound %}
            std::is_same_v<Tag, typename ports::{{ port.name }}::Any> ||
{% endfor %}
            false;

        template <typename Tag>
        static constexpr bool can_tag_fan_in_v =
{% for item in model.inbound_fan_in_tags %}
            std::is_same_v<Tag, {{ item.tag }}> ||
            std::is_same_v<Tag, typename {{ item.tag }}::Any> ||
{% endfor %}
            false;

        // --- 9. Inbound Field Reader (read) Traits ---
        template <typename Port>
        static constexpr bool has_port_readable_v =
{% for port in model.read_ports %}
{% if port.readable_field_count > 0 %}
            std::is_same_v<Port, ports::{{ port.name }}> ||
{% endif %}
{% endfor %}
            false;

        template <typename Port>
        static constexpr bool is_port_read_ambiguous_v =
{% for port in model.read_ports %}
{% if port.readable_field_count > 1 %}
            std::is_same_v<Port, ports::{{ port.name }}> ||
{% endif %}
{% endfor %}
            false;

        template <typename Port, typename Tag>
        static constexpr bool can_port_read_v =
{% for port in model.read_ports %}
{% for field in port.readable_fields %}
            (std::is_same_v<Port, ports::{{ port.name }}> && (
                std::is_same_v<Tag, ports::{{ port.name }}::{{ field.name }}> ||
                std::is_same_v<Tag, {{ field.tag }}>
            )) ||
{% endfor %}
{% endfor %}
            false;

        template <typename Tag>
        static constexpr bool is_ambiguous_read_tag_v =
{% for ambig in model.read_ambiguous_bare_tags %}
            std::is_same_v<Tag, {{ ambig.tag }}> ||
{% endfor %}
            false;

        template <typename Tag>
        static constexpr bool can_read_tag_v =
{% for field in model.read_fields_by_port_tag %}
{% if field.has_getter %}
            std::is_same_v<Tag, ports::{{ field.port_name }}::{{ field.name }}> ||
{% endif %}
{% endfor %}
{% for field in model.read_unique_bare_fields %}
{% if field.has_getter %}
            std::is_same_v<Tag, {{ field.tag }}> ||
{% endif %}
{% endfor %}
            false;

        template <typename DataType>
        static constexpr bool is_ambiguous_read_type_v =
{% for item in model.read_ambiguous_types %}
            std::is_same_v<std::decay_t<DataType>, {{ item.type }}> ||
{% endfor %}
            false;

        template <typename DataType>
        static constexpr bool can_read_type_v =
{% for item in model.read_by_type %}
{% if not item.is_ambiguous %}
            std::is_same_v<std::decay_t<DataType>, {{ item.type }}> ||
{% endif %}
{% endfor %}
            false;

        template <typename Tag>
        static constexpr bool can_read_v =
            // 1. Port with exactly one readable field
{% for port in model.read_ports %}
{% if port.readable_field_count == 1 %}
            std::is_same_v<Tag, ports::{{ port.name }}> ||
{% endif %}
{% endfor %}
            // 2. Port-scoped field tag with getter
{% for field in model.read_fields_by_port_tag %}
{% if field.has_getter %}
            std::is_same_v<Tag, ports::{{ field.port_name }}::{{ field.name }}> ||
{% endif %}
{% endfor %}
            // 3. Unique bare field tag with getter
{% for field in model.read_unique_bare_fields %}
{% if field.has_getter %}
            std::is_same_v<Tag, {{ field.tag }}> ||
{% endif %}
{% endfor %}
            // 4. Unique data type
{% for item in model.read_by_type %}
{% if not item.is_ambiguous %}
            std::is_same_v<std::decay_t<Tag>, {{ item.type }}> ||
{% endif %}
{% endfor %}
            false;

        template <typename Tag>
        static constexpr bool is_ambiguous_read_v =
            // 1. Port with multiple readable fields
{% for port in model.read_ports %}
{% if port.readable_field_count > 1 %}
            std::is_same_v<Tag, ports::{{ port.name }}> ||
{% endif %}
{% endfor %}
            // 2. Ambiguous bare field tag
{% for ambig in model.read_ambiguous_bare_tags %}
            std::is_same_v<Tag, {{ ambig.tag }}> ||
{% endfor %}
            // 3. Ambiguous data type
{% for item in model.read_ambiguous_types %}
            std::is_same_v<std::decay_t<Tag>, {{ item.type }}> ||
{% endfor %}
            false;

        // --- 10. Tag Exact Arguments & Field Capabilities Traits ---
        template <typename Tag, typename... Args>
        static constexpr bool can_tag_emit_with_args_v =
{% for item in model.outbound_tagged %}
            (std::is_same_v<Tag, {{ item.tag | replace('typename ActorBase::', '') }}> &&
             sizeof...(Args) == {{ item.arg_types | length }} &&
             std::is_constructible_v<std::tuple<{{ item.arg_types | join(', ') }}>, Args...>) ||
{% endfor %}
            false;

        template <typename Tag>
        static constexpr bool is_field_without_setter_v =
{% for item in model.all_fields_without_setter %}
            std::is_same_v<Tag, {{ item.tag | replace('typename ActorBase::', '') }}> ||
{% endfor %}
            false;

        template <typename Tag>
        static constexpr bool is_field_without_notifier_v =
{% for item in model.all_fields_without_notifier %}
            std::is_same_v<Tag, {{ item.tag | replace('typename ActorBase::', '') }}> ||
{% endfor %}
            false;
    };

    {{ model.exe_name }}ActorBase() = default;
    virtual ~{{ model.exe_name }}ActorBase() = default;

{% for proxy in model.consumed_proxies %}
    /**
     * @brief Direct unleased raw pointer query.
     * @warning NOT thread-safe against concurrent service restarts or proxy replacements.
     * Intended primarily for single-threaded test bench mock wiring or inspection.
     * In concurrent application code, always use acquire_{{ proxy.ident }}_proxy() which returns a safe RAII ProxyLease.
     */
    {{ proxy.cls }}* get_{{ proxy.ident }}_proxy() const noexcept { return {{ proxy.slot_name }}.get(); }
    bool is_{{ proxy.ident }}_ready() const noexcept { 
        return {{ proxy.ident }}_open_.load(std::memory_order_acquire) && {{ proxy.slot_name }}.is_available(); 
    }
    reaktar::ProxyLease<{{ proxy.cls }}> acquire_{{ proxy.ident }}_proxy() { return {{ proxy.slot_name }}.acquire("{{ proxy.ident }}"); }
    std::optional<typename {{ proxy.cls }}::HandleType> get_{{ proxy.ident }}_handle() const noexcept { 
        return {{ proxy.slot_name }}.get_handle(); 
    }
{% if proxy.is_unique_service and proxy.service_ident != proxy.ident %}
    {{ proxy.cls }}* get_{{ proxy.service_ident }}_proxy() const noexcept { return get_{{ proxy.ident }}_proxy(); }
    bool is_{{ proxy.service_ident }}_ready() const noexcept { return is_{{ proxy.ident }}_ready(); }
    reaktar::ProxyLease<{{ proxy.cls }}> acquire_{{ proxy.service_ident }}_proxy() { return acquire_{{ proxy.ident }}_proxy(); }
    std::optional<typename {{ proxy.cls }}::HandleType> get_{{ proxy.service_ident }}_handle() const noexcept { return get_{{ proxy.ident }}_handle(); }
{% endif %}
{% endfor %}

    /**
     * @brief Direct unleased raw pointer query by Port tag.
     * @warning In concurrent code, use acquire_proxy<Port>() for RAII lease safety.
     */
    template <typename Port>
    auto* get_proxy() const noexcept {
{% for proxy in model.consumed_proxies %}
        {{ "if" if loop.first else "else if" }} constexpr (std::is_same_v<Port, typename ports::{{ proxy.port_name }}>) {
            return get_{{ proxy.ident }}_proxy();
        }
{% endfor %}
{% if model.consumed_proxy_count > 0 %}
        else {
            static_assert(!sizeof(Port*), "Unknown port tag passed to get_proxy<Port>()");
        }
{% else %}
        static_assert(!sizeof(Port*), "get_proxy<Port>() called on Actor with 0 consumed proxies");
{% endif %}
    }

    template <typename Port>
    bool is_port_ready() const noexcept {
{% for proxy in model.consumed_proxies %}
        {{ "if" if loop.first else "else if" }} constexpr (std::is_same_v<Port, typename ports::{{ proxy.port_name }}>) {
            return is_{{ proxy.ident }}_ready();
        }
{% endfor %}
{% if model.consumed_proxy_count > 0 %}
        else {
            static_assert(!sizeof(Port*), "Unknown port tag passed to is_port_ready<Port>()");
        }
{% else %}
        static_assert(!sizeof(Port*), "is_port_ready<Port>() called on Actor with 0 consumed proxies");
{% endif %}
    }

    template <typename Port>
    auto acquire_proxy() {
{% for proxy in model.consumed_proxies %}
        {{ "if" if loop.first else "else if" }} constexpr (std::is_same_v<Port, typename ports::{{ proxy.port_name }}>) {
            return acquire_{{ proxy.ident }}_proxy();
        }
{% endfor %}
{% if model.consumed_proxy_count > 0 %}
        else {
            static_assert(!sizeof(Port*), "Unknown port tag passed to acquire_proxy<Port>()");
        }
{% else %}
        static_assert(!sizeof(Port*), "acquire_proxy<Port>() called on Actor with 0 consumed proxies");
{% endif %}
    }

    static constexpr size_t kConsumedProxyCount = {{ model.consumed_proxy_count }};

    /**
     * @brief Check whether all required service proxies have been resolved and published.
     * Always returns true if this Actor consumes 0 services.
     */
    bool is_ready() const noexcept {
{% if model.consumed_proxy_count == 0 %}
        return true;
{% else %}
        return readiness_.is_ready([this] {
            return ({% for proxy in model.consumed_proxies %}{{ proxy.slot_name }}.is_available(){{ " && " if not loop.last else "" }}{% endfor %});
        });
{% endif %}
    }

    /**
     * @brief Block until all required service proxies have been resolved and published.
     * Fully zero-cost: if this Actor consumes 0 services, returns true immediately without locks or cv.
     */
    bool wait_until_ready() {
{% if model.consumed_proxy_count == 0 %}
        return true;
{% else %}
        return readiness_.wait_until_ready([this] {
            return ({% for proxy in model.consumed_proxies %}{{ proxy.slot_name }}.is_available(){{ " && " if not loop.last else "" }}{% endfor %});
        });
{% endif %}
    }

    /**
     * @brief Block with a timeout until all required service proxies have been resolved and published.
     * Returns true if ready, false if timeout expired.
     */
    template <typename Rep, typename Period>
    bool wait_until_ready(const std::chrono::duration<Rep, Period>& timeout) {
{% if model.consumed_proxy_count == 0 %}
        (void)timeout;
        return true;
{% else %}
        return readiness_.wait_until_ready([this] {
            return ({% for proxy in model.consumed_proxies %}{{ proxy.slot_name }}.is_available(){{ " && " if not loop.last else "" }}{% endfor %});
        }, timeout);
{% endif %}
    }

protected:
{% if model.consumed_proxy_count > 0 %}
    void notify_proxy_resolved() {
        readiness_.notify_resolved();
    }

    reaktar::ReadinessTracker<kConsumedProxyCount> readiness_{};
{% endif %}
{% for proxy in model.consumed_proxies %}
    reaktar::ProxySlot<{{ proxy.cls }}> {{ proxy.slot_name }}{};
    mutable std::mutex {{ proxy.ident }}_port_mutex_{};
    std::optional<ara::com::FindServiceHandle> {{ proxy.find_handle_name }} REAKTAR_GUARDED_BY({{ proxy.ident }}_port_mutex_){std::nullopt};
    std::atomic<bool> {{ proxy.ident }}_open_{false};
    uint64_t {{ proxy.ident }}_generation_ REAKTAR_GUARDED_BY({{ proxy.ident }}_port_mutex_){0};
{% endfor %}

    using port_mask_t = typename ports::port_mask_t;
    std::atomic<port_mask_t> dirty_ports_{0};
    port_mask_t last_known_ready_{0};
};


